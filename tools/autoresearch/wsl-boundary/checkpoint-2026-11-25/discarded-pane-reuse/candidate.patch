+import assert from "node:assert/strict";
+import test from "node:test";
+import { createDiff } from "./editor.js";
+
+// Empty diffs use the real controller without constructing CodeMirror. Actual
+// pane layout and native input need the separate native regression sequence.
+class Node {
+  constructor(tag) {
+    this.tag = tag;
+    this.children = [];
+    this.events = {};
+    this.style = {
+      setProperty(key, value) { this[key] = value; },
+      removeProperty(key) { delete this[key]; },
+      getPropertyValue(key) { return this[key] ?? ""; },
+    };
+    this.classList = { toggle() {} };
+  }
+  addEventListener(type, listener) { this.events[type] = listener; }
+  setAttribute() {}
+  append(...nodes) {
+    for (const node of nodes) { node.parent = this; this.children.push(node); }
+  }
+  replaceChildren(...nodes) { this.children = []; this.append(...nodes); }
+  remove() {
+    if (this.parent) this.parent.children = this.parent.children.filter((n) => n !== this);
+  }
+  contains(node) { return node === this || this.children.some((child) => child.contains(node)); }
+}
+
+function fixture(loadContents) {
+  const previousDocument = globalThis.document;
+  const previousCancel = globalThis.cancelAnimationFrame;
+  const previousWindow = globalThis.window;
+  globalThis.document = { createElement: (tag) => new Node(tag), activeElement: null };
+  globalThis.cancelAnimationFrame = () => {};
+  globalThis.window = { devicePixelRatio: 1 };
+  const parent = new Node("parent");
+  const actions = [];
+  const diff = createDiff(parent, {
+    file: { path: "binary", binary: true, added: null, removed: null },
+    lines: [], loadContents,
+    onCompose: () => actions.push("compose"),
+    onStatus: () => actions.push("status"),
+    onContextChange: () => actions.push("context"),
+  });
+  return { diff, parent, actions, cleanup() {
+    diff.destroy();
+    globalThis.document = previousDocument;
+    globalThis.cancelAnimationFrame = previousCancel;
+    globalThis.window = previousWindow;
+  } };
+}
+
+test("suspension keeps the earlier active root above the later cached layout", () => {
+  const f = fixture(async () => ["old contents"]);
+  try {
+    f.diff.setMode("split");
+    f.diff.setMode("unified");
+    assert.equal(f.parent.children.length, 2);
+    const roots = [...f.parent.children];
+    const oldComment = roots[1].children[0].children.find((node) => node.tag === "button");
+    f.diff.suspend();
+    assert.equal(f.parent.children.length, 2);
+    assert.ok(roots.every((root) => root.inert));
+    assert.equal(roots[0].style.getPropertyValue("z-index"), "1");
+    assert.equal(roots[1].style.getPropertyValue("z-index"), "");
+    assert.equal(f.diff.setDocument({file: {path: "new.txt", added: 1, removed: 0}, lines: [{kind: "+", text: "new", new: 1}]}), false);
+    oldComment.events.click();
+    f.diff.comment();
+    assert.deepEqual(f.actions, []);
+    f.diff.destroy();
+    assert.equal(f.parent.children.length, 0);
+    assert.ok(roots.every((root) => root.style.getPropertyValue("z-index") === ""));
+  } finally { f.cleanup(); }
+});
+
+for (const reject of [false, true]) {
+  test(`suspension ignores a pending content ${reject ? "failure" : "result"} and reveal`, async () => {
+    let finish;
+    const pending = new Promise((resolve, fail) => { finish = reject ? fail : resolve; });
+    const f = fixture(() => pending);
+    try {
+      const contents = f.diff.contents();
+      const reveal = f.diff.revealLine("new", 20);
+      f.diff.suspend();
+      finish(reject ? Error("stale native failure") : ["stale contents"]);
+      assert.equal(await contents, undefined);
+      assert.equal(await reveal, false);
+      assert.deepEqual(f.actions, []);
+      assert.equal(await f.diff.contents(), undefined);
+    } finally { f.cleanup(); }
+  });
+}
