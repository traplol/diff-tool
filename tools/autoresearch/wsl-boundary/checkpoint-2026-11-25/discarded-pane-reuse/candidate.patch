@@ -0,0 +1,55 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { EditorState, Text } from "@codemirror/state";
+import { diffRows, rowUpdates } from "./editor.js";
+
+const patch = (texts) => texts.map((text, i) => ({ kind: " ", text, old: i + 1, new: i + 1, hunk: 1 }));
+function update(before, after, split) {
+  const oldRows = diffRows(before, split), rows = diffRows(after, split);
+  const states = Array.from({ length: split ? 2 : 1 }, (_, col) =>
+    EditorState.create({ doc: Text.of(oldRows.length ? oldRows.map((row) => before[row[col]]?.text ?? "") : [""]) }));
+  const updates = rowUpdates(oldRows, before, rows, after, states.map((state) => state.doc));
+  states.forEach((state, col) => {
+    const actual = updates[col] ? state.changes(updates[col]).apply(state.doc) : state.doc;
+    assert.equal(actual.toString(), Text.of(rows.length ? rows.map((row) => after[row[col]]?.text ?? "") : [""]).toString());
+  });
+  return { updates, states };
+}
+
+test("fresh snapshots with identical text preserve the document despite metadata changes", () => {
+  const before = patch(["same", "", "Unicode 🛠"]);
+  const after = before.map((line) => ({ ...line, old: line.old + 100, new: line.new + 200, hunk: 4 }));
+  for (const split of [false, true]) assert.ok(update(before, after, split).updates.every((change) => change === undefined));
+  assert.ok(update(before, after.map((line) => ({ ...line, kind: "+" })), false).updates.every((change) => change === undefined));
+});
+
+test("text updates retain the matching prefix and suffix", () => {
+  const { updates, states } = update(patch(["prefix", "old", "suffix"]), patch(["prefix", "new", "suffix"]), false);
+  assert.equal(updates[0].from, states[0].doc.line(2).from);
+  assert.equal(updates[0].to, states[0].doc.line(3).from);
+  assert.equal(updates[0].insert.toString(), "new\n");
+});
+
+test("row changes handle boundary inserts, deletion, replacement, empty lines and fresh objects", () => {
+  const before = patch(["a", "b", "c"]);
+  const variants = [[], ["a", "b", "c"], ["first", "a", "b", "c"], ["a", "middle", "b", "c"],
+    ["a", "b", "c", "last"], ["b", "c"], ["a", "c"], ["a", "b"], ["new"],
+    ["a", "b", "c", ""], ["", "a", "b", "c"], ["a", "", "c"], ["\t", "é", "🛠"]];
+  for (const split of [false, true]) {
+    for (const texts of variants) update(before, patch(texts), split);
+    update([], patch(["first"]), split);
+    update([], [], split);
+  }
+});
+
+test("each cached layout can independently catch up from a different previous snapshot", () => {
+  const a = [{ kind: "-", text: "old", old: 1 }, { kind: "+", text: "new", new: 1 }];
+  const b = [...a, { kind: "+", text: "extra", new: 2 }];
+  const c = [{ kind: " ", text: "context", old: 4, new: 4 },
+    { kind: "-", text: "removed", old: 5 }, { kind: "+", text: "replacement", new: 5 },
+    { kind: "+", text: "uneven", new: 6 }];
+  update(a, b, false); // Unified advanced while Split still owns A.
+  update(a, c, true);  // Split must use its own A rows/doc, never Unified's B.
+  update(b, c, false);
+  update(c, a, true);
+});
