+// The Windows cache contains GUI-validated source bytes. Copy and validate the
+// worker inside WSL, then replace the shell so the existing process owner and
+// raw worker pipes remain unchanged. Paths and the digest are positional data.
+#[cfg(any(windows, all(test, unix)))]
+const WSL_BOOTSTRAP: &str = r#"set -eu
+source=$(wslpath -u "$1")
+digest=$2
+temporary=
+matches() {
+    [ -f "$1" ] || return 1
+    actual=$(sha256sum < "$1") || return 1
+    [ "${actual%% *}" = "$digest" ]
+}
+fallback() {
+    if [ -n "$temporary" ]; then
+        rm -f -- "$temporary" || exit 1
+        temporary=
+    fi
+    matches "$source" || exit 1
+    exec "$source" --stdio
+}
+cache=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}
+case "$cache" in /*) ;; *) fallback ;; esac
+directory=$cache/branchline/git-workers
+umask 077
+mkdir -p -- "$directory" || fallback
+worker=$directory/branchline-git-worker-$digest
+if ! matches "$worker"; then
+    temporary=$(mktemp "$directory/.branchline-git-worker.XXXXXX") || fallback
+    trap 'rm -f -- "$temporary"' EXIT
+    trap 'exit 1' HUP INT TERM
+    cp -- "$source" "$temporary" || fallback
+    matches "$temporary" || exit 1
+    chmod 755 "$temporary" || fallback
+    mv -fT -- "$temporary" "$worker" || fallback
+    temporary=
+fi
+chmod 755 "$worker" || fallback
+[ -x "$worker" ] || fallback
+exec "$worker" --stdio"#;
+
+#[cfg(windows)]
