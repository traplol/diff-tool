+    #[cfg(unix)]
+    #[test]
+    fn native_wsl_bootstrap_execs_one_worker_and_preserves_raw_pipes() {
+        use std::io::Read;
+        let directory = tempfile::tempdir().unwrap();
+        let (source, bin, digest, bytes) = bootstrap_fixture(directory.path());
+        let cache = directory
+            .path()
+            .join("cache's réview space ;$(touch injected)");
+        for corrupt in [false, true, false] {
+            let native = cache.join(format!(
+                "branchline/git-workers/branchline-git-worker-{digest}"
+            ));
+            if corrupt {
+                fs::write(&native, b"broken cache").unwrap();
+            }
+            let mut child = bootstrap_command(&source, &cache, &digest, &bin)
+                .stdin(Stdio::piped())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::piped())
+                .spawn()
+                .unwrap();
+            let mut output = BufReader::new(child.stdout.take().unwrap());
+            let mut pid = String::new();
+            output.read_line(&mut pid).unwrap();
+            // exec keeps the owned shell PID rather than adding a worker child.
+            assert_eq!(pid.trim().parse::<u32>().unwrap(), child.id());
+            let raw = [0, 255, 128, b'\n', b'\r', b'"', b'\\'];
+            child.stdin.take().unwrap().write_all(&raw).unwrap();
+            let mut returned = Vec::new();
+            output.read_to_end(&mut returned).unwrap();
+            assert_eq!(returned, raw);
+            assert!(child.wait().unwrap().success());
+            assert_eq!(fs::read(&native).unwrap(), bytes);
+            assert_eq!(fs::read_dir(native.parent().unwrap()).unwrap().count(), 1);
+            assert!(!directory.path().join("injected").exists());
+        }
+        // A correct native cache can start after its foreign source disappears.
+        fs::remove_file(&source).unwrap();
+        assert!(bootstrap_command(&source, &cache, &digest, &bin)
+            .stdin(Stdio::null())
+            .output()
+            .unwrap()
+            .status
+            .success());
+    }
