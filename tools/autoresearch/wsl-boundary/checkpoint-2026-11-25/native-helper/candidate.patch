+    fn native_wsl_bootstrap_unavailable_cache_execs_verified_source_without_temporary_leaks() {
+        use std::os::unix::fs::PermissionsExt;
+        let directory = tempfile::tempdir().unwrap();
+        let (source, bin, digest, _) = bootstrap_fixture(directory.path());
+        let readonly = directory.path().join("readonly-cache");
+        fs::create_dir(&readonly).unwrap();
+        fs::set_permissions(&readonly, fs::Permissions::from_mode(0o555)).unwrap();
+        let blocked = directory.path().join("blocked-destination");
+        let cache_directory = blocked.join("branchline/git-workers");
+        let blocked_worker = cache_directory.join(format!("branchline-git-worker-{digest}"));
+        fs::create_dir_all(&blocked_worker).unwrap();
+        for cache in [&readonly, &blocked, Path::new("relative-cache")] {
+            let mut child = bootstrap_command(&source, cache, &digest, &bin)
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null())
+                .spawn()
+                .unwrap();
+            let mut pid = String::new();
+            BufReader::new(child.stdout.take().unwrap())
+                .read_line(&mut pid)
+                .unwrap();
+            assert_eq!(pid.trim().parse::<u32>().unwrap(), child.id());
+            assert!(child.wait().unwrap().success());
+        }
+        fs::set_permissions(&readonly, fs::Permissions::from_mode(0o755)).unwrap();
+        assert_eq!(fs::read_dir(&readonly).unwrap().count(), 0);
+        assert_eq!(fs::read_dir(&cache_directory).unwrap().count(), 1);
+        assert_eq!(fs::read_dir(&blocked_worker).unwrap().count(), 0);
+        // The fallback must not execute source bytes changed after validation.
+        fs::write(&source, b"#!/bin/sh\nprintf 'wrong source executed'\n").unwrap();
+        let output = bootstrap_command(&source, &blocked, &digest, &bin)
+            .stdin(Stdio::null())
+            .output()
+            .unwrap();
+        assert!(!output.status.success());
+        assert!(output.stdout.is_empty());
+        assert_eq!(fs::read_dir(cache_directory).unwrap().count(), 1);
+    }
