+    #[cfg(unix)]
+    fn bootstrap_command(source: &Path, cache: &Path, digest: &str, bin: &Path) -> Command {
+        let mut command = Command::new("/bin/sh");
+        command
+            .args(["-c", WSL_BOOTSTRAP, "branchline-git-worker"])
+            .arg(source)
