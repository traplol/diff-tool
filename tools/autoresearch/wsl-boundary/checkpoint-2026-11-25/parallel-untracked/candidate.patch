+#[test]
+fn parallel_untracked_keeps_git_order_raw_patches_and_frozen_content() {
+    let dir = history();
+    let root = dir.path();
+    write(&dir, "tracked", b"base\n");
+    write(&dir, ".gitignore", b"ignored\n");
+    record(&dir, "Base");
+    for (path, bytes) in [
+        ("a-empty", b"".as_slice()),
+        ("b-text", b"first\nsecond\n"),
+        ("c-binary", b"binary\0bytes"),
+        ("d space", b"space\n"),
+        ("e[1]", b"literal\n"),
+        ("g-last", b"last\n"),
+        ("ignored", b"hidden\n"),
+    ] {
+        write(&dir, path, bytes);
+    }
+    let nested = root.join("f-nested");
+    fs::create_dir(&nested).unwrap();
+    git(&nested, &["init", "-qb", "main"]).unwrap();
+    git(&nested, &["config", "user.name", "Nested"]).unwrap();
+    git(&nested, &["config", "user.email", "nested@example.test"]).unwrap();
+    git(&nested, &["config", "commit.gpgsign", "false"]).unwrap();
+    fs::write(nested.join("inside"), b"nested\n").unwrap();
+    git(&nested, &["add", "."]).unwrap();
+    git(&nested, &["commit", "-qm", "Nested"]).unwrap();
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(".", root.join("h-dirlink")).unwrap();
+    let before = status_guard_files(root);
+    let mut repo = open_repo(root).unwrap();
+    repo.native = None;
+    let snapshot = work(&repo);
+    let listed = git(
+        root,
+        &["ls-files", "--others", "--exclude-standard", "-z", "--"],
+    )
+    .unwrap();
+    let expected = listed
+        .split(|&byte| byte == 0)
+        .filter(|path| !path.is_empty())
+        .map(|path| name(path.strip_suffix(b"/").unwrap_or(path)))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        snapshot
+            .files
+            .iter()
+            .map(|file| file.path.clone())
+            .collect::<Vec<_>>(),
+        expected
+    );
+    assert!(snapshot.files.len() > 4, "exercise multiple batches");
+    assert!(snapshot.files.iter().all(|file| file.group == "Untracked"));
+    assert_eq!(file(&snapshot, "Untracked", "c-binary").added, None);
+    assert_eq!(file(&snapshot, "Untracked", "a-empty").added, Some(0));
+    assert_eq!(file(&snapshot, "Untracked", "f-nested").mode, "160000");
+    assert_eq!(
+        file(&snapshot, "Untracked", "f-nested").oid,
+        git_text(&nested, &["rev-parse", "HEAD"]).unwrap()
+    );
+    #[cfg(unix)]
+    {
+        assert_eq!(file(&snapshot, "Untracked", "h-dirlink").mode, "120000");
+        assert_eq!(content(&repo, &snapshot, "Untracked", "h-dirlink"), ["."]);
+    }
+    // Compare regular-file captures with the original one-at-a-time Git reads.
+    for change in &snapshot.files {
+        if change.mode == "160000" || change.mode == "120000" {
+            continue;
+        }
+        let mut source = OsString::from("./");
+        source.push(path_arg(&change.path).unwrap());
+        let mut expected = local_changes(
+            &repo,
+            "Untracked",
+            &[
+                "--no-index".as_ref(),
+                "--".as_ref(),
+                "/dev/null".as_ref(),
+                &source,
+            ],
+            true,
+        )
+        .unwrap();
+        expected[0].old = change.old.clone();
+        expected[0].path = change.path.clone();
+        assert_eq!(
+            serde_json::to_value(change).unwrap(),
+            serde_json::to_value(&expected[0]).unwrap()
+        );
+        assert_eq!(change.local_sections, expected[0].local_sections);
+    }
+    let frozen = snapshot
+        .files
+        .iter()
+        .map(|change| {
+            (
+                patch(&repo, &snapshot, change).unwrap(),
+                file_contents(&repo, change),
+            )
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(status_guard_files(root), before);
+    for path in ["a-empty", "b-text", "c-binary", "d space", "e[1]", "g-last"] {
+        fs::remove_file(root.join(path)).unwrap();
+    }
+    #[cfg(unix)]
+    fs::remove_file(root.join("h-dirlink")).unwrap();
+    write(&dir, "tracked", b"new staged content\n");
+    git(root, &["add", "tracked"]).unwrap();
+    for (change, (rows, contents)) in snapshot.files.iter().zip(frozen) {
+        assert_eq!(patch(&repo, &snapshot, change).unwrap(), rows);
+        assert_eq!(file_contents(&repo, change), contents);
+    }
+}
