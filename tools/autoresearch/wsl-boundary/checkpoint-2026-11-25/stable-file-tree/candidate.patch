+
+test("file-tree reuse follows visual entries while editor snapshots change", () => {
+  const source = [
+    { path: "src/a.rs", old: "src/a.rs", status: "M", group: "", oid: "old-head", old_oid: "old-base", mode: "100644", added: 1, local_sections: ["old patch"] },
+    { path: "src/b.rs", old: "before/b.rs", status: "R", group: "", oid: "old-rename" },
+  ];
+  const fresh = source.map((file) => ({
+    ...file, oid: "new-head", old_oid: "new-base", mode: "100755", added: 9,
+    local_sections: ["new patch"],
+  }));
+  const tree = { root: "/repo", source };
+  assert.equal(canReuseFileTree(tree, "/repo", fresh), true);
+  assert.notEqual(fresh[0].oid, source[0].oid);
+  assert.notDeepEqual(fresh[0].local_sections, source[0].local_sections);
+  assert.equal(canReuseFileTree(tree, "/another-repo", fresh), false);
+});
+
+test("file-tree labels, grouping and indices invalidate reuse when they change", () => {
+  const source = [
+    { path: "src/new.rs", old: "src/old.rs", status: "R", group: "Staged" },
+    { path: "src/new.rs", old: "src/new.rs", status: "M", group: "Unstaged" },
+  ];
+  const tree = { root: "/repo", source };
+  assert.equal(canReuseFileTree(tree, "/repo", source.map((file) => ({ ...file }))), true);
+  for (const changed of [
+    { path: "src/other.rs" }, { old: "before/old.rs" }, { status: "M" }, { group: "Unstaged" },
+  ]) {
+    assert.equal(canReuseFileTree(tree, "/repo", [{ ...source[0], ...changed }, source[1]]), false);
+  }
+  assert.equal(canReuseFileTree(tree, "/repo", [...source].reverse()), false);
+  assert.equal(canReuseFileTree(tree, "/repo", source.slice(1)), false);
+  assert.equal(canReuseFileTree(tree, "/repo", [...source, { ...source[1], path: "added.rs" }]), false);
+});
+
+test("empty file trees can persist only in the same repository", () => {
+  assert.equal(canReuseFileTree(undefined, "/repo", []), false);
+  assert.equal(canReuseFileTree({ root: "/repo", source: [] }, "/repo", undefined), true);
+  assert.equal(canReuseFileTree({ root: "/repo" }, "/repo", []), true);
+  assert.equal(canReuseFileTree({ root: "/repo", source: [] }, "/other", []), false);
+});
