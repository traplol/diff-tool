+// Tree buttons capture an index; their labels depend only on these fields.
+export function canReuseFileTree(tree, root, source) {
+  if (!tree || tree.root !== root) return false;
+  const previous = tree.source ?? [],
+    next = source ?? [];
+  return previous === next || (
+    previous.length === next.length &&
+    previous.every((file, i) =>
+      file.path === next[i].path && file.old === next[i].old &&
+      file.status === next[i].status && file.group === next[i].group,
+    )
+  );
+}
