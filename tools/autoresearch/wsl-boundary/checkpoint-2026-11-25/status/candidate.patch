+#[test]
+fn windows_status_git_parity_handles_unborn_conflicts_and_linked_worktrees() {
+    let dir = history();
+    write(&dir, "draft", b"untracked before first commit\n");
+    assert_eq!(assert_windows_status_listing(dir.path()), b"draft\0");
+    git(dir.path(), &["add", "draft"]).unwrap();
+    write(&dir, "new draft", b"untracked beside unborn index\n");
+    assert_eq!(assert_windows_status_listing(dir.path()), b"new draft\0");
+    record(&dir, "Base");
+    git(dir.path(), &["switch", "-qc", "other"]).unwrap();
+    write(&dir, "draft", b"other\n");
+    record(&dir, "Other");
+    git(dir.path(), &["switch", "-q", "main"]).unwrap();
+    write(&dir, "draft", b"main\n");
+    record(&dir, "Main");
+    assert!(git(dir.path(), &["merge", "--no-edit", "other"]).is_err());
+    write(&dir, "untracked conflict note", b"review\n");
+    assert_eq!(assert_windows_status_listing(dir.path()), b"untracked conflict note\0");
+    git(dir.path(), &["merge", "--abort"]).unwrap();
+    let linked = tempfile::tempdir().unwrap();
+    let linked_root = linked.path().join("linked");
+    git(dir.path(), &["worktree", "add", "--detach", linked_root.to_str().unwrap(), "HEAD"]).unwrap();
+    fs::write(linked_root.join("literal[1]"), b"linked worktree review\n").unwrap();
+    assert_eq!(assert_windows_status_listing(&linked_root), b"literal[1]\0");
+}
