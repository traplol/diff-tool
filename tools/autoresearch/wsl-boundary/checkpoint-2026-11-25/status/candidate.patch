+#[test]
+fn windows_status_parser_keeps_raw_question_paths_and_ignores_valid_tracked_records() {
+    let oid = "a".repeat(40);
+    let mut data = format!("1 MM N... 100644 100644 100644 {oid} {oid} tracked path\0").into_bytes();
+    data.extend_from_slice(format!("u UU N... 100644 100644 100644 100644 {oid} {oid} {oid} conflicted\0").as_bytes());
+    data.extend_from_slice(b"? leading space\0?  two spaces\0? tabs\tand\nnewlines\0? invalid\xff\0? nested/\0");
+    assert_eq!(status_untracked_names(&data).unwrap(),
+        b"leading space\0 two spaces\0tabs\tand\nnewlines\0invalid\xff\0nested/\0");
+    let sha256 = "f".repeat(64);
+    let data = format!("1 .M S.MU 160000 160000 160000 {sha256} {sha256} submodule\0? file\0");
+    assert_eq!(status_untracked_names(data.as_bytes()).unwrap(), b"file\0");
+    assert!(status_untracked_names(b"").unwrap().is_empty());
+}
