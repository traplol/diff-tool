+// Porcelain v2 keeps paths as raw bytes with -z. Accept only the formats this
+// command requests, so new or malformed output uses the original listing.
+#[cfg(any(windows, test))]
+fn status_untracked_names(data: &[u8]) -> Result<Vec<u8>> {
+    if data.is_empty() {
+        return Ok(Vec::new());
+    }
+    let records = data.strip_suffix(b"\0").ok_or("Invalid Git status terminator.")?;
+    let mut names = Vec::new();
+    for record in records.split(|byte| *byte == 0) {
+        if let Some(path) = record.strip_prefix(b"? ") {
+            if !status_relative_path(path) {
+                return Err("Invalid Git status path.".into());
+            }
+            names.extend_from_slice(path);
+            names.push(0);
+            continue;
+        }
+        let unmerged = record.starts_with(b"u ");
+        if !unmerged && !record.starts_with(b"1 ") {
+            return Err("Unsupported Git status record.".into());
+        }
+        let field_count = if unmerged { 11 } else { 9 };
+        let fields = record.splitn(field_count, |byte| *byte == b' ').collect::<Vec<_>>();
+        let mode_end = if unmerged { 7 } else { 6 };
+        let valid_submodule = |field: &[u8]| {
+            field == b"N..." || field.len() == 4 && field[0] == b'S'
+                && b".C".contains(&field[1]) && b".M".contains(&field[2])
+                && b".U".contains(&field[3])
+        };
+        if fields.len() != field_count
+            || fields[1].len() != 2
+            || if unmerged {
+                !matches!(fields[1], b"DD" | b"AU" | b"UD" | b"UA" | b"DU" | b"AA" | b"UU")
+            } else {
+                !fields[1].iter().all(|byte| b".MTADRC".contains(byte))
+            }
+            || !valid_submodule(fields[2])
+            || !fields[3..mode_end].iter().all(|mode| mode.len() == 6
+                && mode.iter().all(|byte| (b'0'..=b'7').contains(byte)))
+            || !fields[mode_end..field_count - 1].iter().all(|oid| matches!(oid.len(), 40 | 64)
+                && oid.iter().all(u8::is_ascii_hexdigit))
+            || !status_relative_path(fields[field_count - 1])
+            || fields[field_count - 1].ends_with(b"/")
+        {
+            return Err("Invalid Git status record.".into());
+        }
+    }
+    Ok(names)
+}
