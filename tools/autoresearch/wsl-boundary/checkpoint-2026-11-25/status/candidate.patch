+#[cfg(any(windows, test))]
+fn status_relative_path(path: &[u8]) -> bool {
+    let path = path.strip_suffix(b"/").unwrap_or(path);
+    if path.is_empty() || path.split(|byte| *byte == b'/')
+        .any(|part| part.is_empty() || part == b"." || part == b"..") {
+        return false;
+    }
+    #[cfg(windows)]
+    if path.contains(&b'\\') || path.get(1) == Some(&b':') && path[0].is_ascii_alphabetic() {
+        return false;
+    }
+    true
+}
