+fn status_guard_files(root: &Path) -> Vec<(String, Option<Vec<u8>>, Option<std::time::SystemTime>, u64)> {
+    ["index", "config", "HEAD"].into_iter().map(|name| {
+        let path = git_text(root, &["rev-parse", "--git-path", name]).unwrap();
+        let path = root.join(path);
+        let bytes = match fs::read(&path) {
+            Ok(bytes) => Some(bytes),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
+            Err(error) => panic!("{path:?}: {error}"),
+        };
+        let metadata = fs::metadata(path).ok();
+        #[cfg(unix)]
+        let inode = {
+            use std::os::unix::fs::MetadataExt;
+            metadata.as_ref().map_or(0, |metadata| metadata.ino())
+        };
+        #[cfg(not(unix))]
+        let inode = 0;
+        (name.into(), bytes, metadata.and_then(|metadata| metadata.modified().ok()), inode)
+    }).collect()
+}
+
+fn assert_windows_status_listing(root: &Path) -> Vec<u8> {
+    let before = status_guard_files(root);
+    let expected = git(root, &["ls-files", "--others", "--exclude-standard", "-z", "--"]).unwrap();
+    let actual = windows_status_untracked(root).unwrap();
+    assert_eq!(actual, expected, "status must retain the original raw NUL-list bytes");
+    assert_eq!(status_guard_files(root), before, "discovery rewrote repository state");
+    actual
+}
