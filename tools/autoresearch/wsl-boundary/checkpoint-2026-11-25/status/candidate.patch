+#[test]
+fn windows_status_git_parity_preserves_ignores_partial_staging_and_user_cache_configuration() {
+    let dir = history();
+    write(&dir, "tracked", b"base\n");
+    write(&dir, "unchanged", b"same bytes\n");
+    write(&dir, ".gitignore", b"ignored\nignored-dir/\n");
+    record(&dir, "Base");
+    write(&dir, "tracked", b"staged\n");
+    git(dir.path(), &["add", "tracked"]).unwrap();
+    write(&dir, "tracked", b"unstaged\n");
+    // Status may refresh stale stat data in memory, but optional locks must
+    // prevent that refresh from replacing the real index.
+    fs::OpenOptions::new().write(true).open(dir.path().join("unchanged")).unwrap()
+        .set_modified(std::time::UNIX_EPOCH + std::time::Duration::from_secs(1_000_000_000)).unwrap();
+    fs::create_dir_all(dir.path().join("folder/deep")).unwrap();
+    fs::create_dir_all(dir.path().join("ignored-dir")).unwrap();
+    for name in ["literal[1]", "--dash", "space name", "folder/deep/file", "ignored", "ignored-dir/file", "info-ignored", "global-ignored"] {
+        write(&dir, name, b"new data\n");
+    }
+    fs::write(dir.path().join(".git/info/exclude"), b"info-ignored\n").unwrap();
+    let excludes = dir.path().parent().unwrap().join(format!("{}-global-ignore", dir.path().file_name().unwrap().to_string_lossy()));
+    fs::write(&excludes, b"global-ignored\n").unwrap();
+    git(dir.path(), &["config", "core.excludesFile", excludes.to_str().unwrap()]).unwrap();
+    fs::create_dir(dir.path().join("nested")).unwrap();
+    git(&dir.path().join("nested"), &["init", "-q"]).unwrap();
+    write(&dir, "nested/file", b"nested checkout\n");
+    for enabled in ["false", "true"] {
+        git(dir.path(), &["config", "core.untrackedCache", enabled]).unwrap();
+        if enabled == "true" {
+            git(dir.path(), &["update-index", "--untracked-cache"]).unwrap();
+            let seed = Command::new("git").arg("-C").arg(dir.path())
+                .args(["status", "--porcelain=v2", "-z", "--untracked-files=all"])
+                .env("GIT_OPTIONAL_LOCKS", "1").output().unwrap();
+            assert!(seed.status.success());
+            assert!(fs::read(dir.path().join(".git/index")).unwrap().windows(4).any(|bytes| bytes == b"UNTR"));
+            write(&dir, "folder/cache-added", b"new after persisted cache\n");
+        }
+        let names = assert_windows_status_listing(dir.path());
+        assert!(names.split(|byte| *byte == 0).any(|name| name == b"nested/"));
+        assert!(!names.split(|byte| *byte == 0).any(|name| name.ends_with(b"ignored")));
+    }
+    fs::remove_file(excludes).unwrap();
+}
