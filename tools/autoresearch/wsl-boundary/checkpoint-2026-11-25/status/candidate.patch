+#[test]
+fn windows_status_parser_rejects_malformed_and_unsupported_records_for_fallback() {
+    let oid = "a".repeat(40);
+    let valid = format!("1 MM N... 100644 100644 100644 {oid} {oid} path\0");
+    let mut invalid = vec![b"? missing terminator".to_vec(), b"? \0".to_vec(), b"\0".to_vec(),
+        b"? good\0\0".to_vec(), b"?no space\0".to_vec(), b"? ../outside\0".to_vec(), b"? /absolute\0".to_vec(),
+        b"? ./file\0".to_vec(), b"? a//b\0".to_vec(), b"? a/../b\0".to_vec(), b"# branch.head main\0".to_vec(),
+        b"! ignored\0".to_vec(), b"2 rename\0source\0".to_vec(), b"1 malformed\0".to_vec()];
+    for (old, new) in [(" MM ", " M "), (" N... ", " N.. "), ("100644", "100649"), (" MM ", " ?? "), (" MM ", " UU "),
+        (" path\0", " \0")] {
+        invalid.push(valid.replacen(old, new, 1).into_bytes());
+    }
+    invalid.push(valid.replacen(&oid, "bad", 1).into_bytes());
+    for data in invalid {
+        assert!(status_untracked_names(&data).is_err(), "accepted malformed status {:?}", String::from_utf8_lossy(&data));
+    }
+}
