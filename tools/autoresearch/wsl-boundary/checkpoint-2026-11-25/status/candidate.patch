+#[cfg(unix)]
+#[test]
+fn windows_status_git_parity_preserves_unix_byte_names_and_configured_monitor_hook() {
+    use std::os::unix::{ffi::OsStrExt, fs::{symlink, PermissionsExt}};
+    let dir = history();
+    write(&dir, "tracked", b"base\n");
+    record(&dir, "Base");
+    for raw in [b"invalid\xff\t\n".as_slice(), b"C:foo", b":(glob)magic*", b"back\\slash"] {
+        fs::write(dir.path().join(OsStr::from_bytes(raw)), b"new bytes\n").unwrap();
+    }
+    symlink("missing", dir.path().join("link")).unwrap();
+    let hook_dir = tempfile::tempdir().unwrap();
+    let hook = hook_dir.path().join("monitor");
+    let marker = hook_dir.path().join("called");
+    fs::write(&hook, format!("#!/bin/sh\nprintf called >> '{}'\nprintf 'token\\0/\\0'\n", marker.display())).unwrap();
+    fs::set_permissions(&hook, fs::Permissions::from_mode(0o755)).unwrap();
+    git(dir.path(), &["config", "core.fsmonitor", hook.to_str().unwrap()]).unwrap();
+    git(dir.path(), &["config", "core.fsmonitorHookVersion", "2"]).unwrap();
+    let names = assert_windows_status_listing(dir.path());
+    assert!(names.split(|byte| *byte == 0).any(|path| path == b"invalid\xff\t\n"));
+    assert!(marker.exists(), "the existing configured Git hook must remain effective");
+}
