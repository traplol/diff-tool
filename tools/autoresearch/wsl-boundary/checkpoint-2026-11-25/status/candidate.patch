+#[cfg(any(windows, test))]
+fn windows_status_untracked(root: &Path) -> Result<Vec<u8>> {
+    let data = git(root, &[
+        "status", "--porcelain=v2", "-z", "--untracked-files=all",
+        "--no-renames", "--ignore-submodules=all",
+    ])?;
+    status_untracked_names(&data)
 }
 
