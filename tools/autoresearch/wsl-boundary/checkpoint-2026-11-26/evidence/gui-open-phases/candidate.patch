+#[cfg(target_os = "linux")]
+fn windows_worker_cache() -> Result<PathBuf> {
+    // Finish and reap this discovery process before creating the worker. A
+    // retained PowerShell wrapper would become Connection's child and prevent
+    // its existing kill/wait path from owning the worker directly.
+    // cmd returns the inherited value without parsing it as shell code. Keep
+    // the known-folder query for a missing environment or unavailable cmd.
+    if let Ok(output) = Command::new("cmd.exe")
+        .args(["/d", "/u", "/c", "set LOCALAPPDATA"])
+        .stdin(Stdio::null())
+        .output()
+    {
+        if let Some(directory) = windows_environment_cache_path(&output.stdout)? {
+            return Ok(wslpath("-u", OsStr::new(&directory))?.join("Branchline/git-workers"));
+        }
+    }
+    let output = Command::new("powershell.exe")
+        .args([
+            "-NoLogo",
+            "-NoProfile",
+            "-NonInteractive",
+            "-Command",
+            "[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false); $directory = $env:LOCALAPPDATA; if ([string]::IsNullOrEmpty($directory)) { $directory = [Environment]::GetFolderPath([Environment+SpecialFolder]::LocalApplicationData) }; [Console]::Write($directory)",
+        ])
+        .stdin(Stdio::null())
+        .output()
+        .map_err(|error| format!("Could not locate the Windows Git worker cache: {error}"))?;
+    if !output.status.success() {
+        return Err("Could not locate the Windows Git worker cache.".into());
+    }
+    let directory = windows_cache_path(&output.stdout)?;
+    Ok(wslpath("-u", OsStr::new(directory))?.join("Branchline/git-workers"))
+}
+
+#[cfg(target_os = "linux")]
+fn windows_environment_cache_path(output: &[u8]) -> Result<Option<String>> {
+    if output.len() % 2 != 0 {
+        return Err("Windows returned an incomplete UTF-16 Git worker cache path.".into());
+    }
+    let units: Vec<u16> = output
+        .chunks_exact(2)
+        .map(|pair| u16::from_le_bytes([pair[0], pair[1]]))
+        .collect();
+    let text = String::from_utf16(&units)
+        .map_err(|_| "Windows returned a non-Unicode Git worker cache path.")?;
+    let mut values = text
+        .split("\r\n")
+        .filter_map(|line| line.split_once('='))
+        .filter(|(name, _)| name.eq_ignore_ascii_case("LOCALAPPDATA"));
+    let Some((_, directory)) = values.next() else {
+        return Ok(None);
+    };
+    if values.next().is_some() {
+        return Err("Windows returned multiple Git worker cache paths.".into());
+    }
+    if directory.is_empty() {
+        return Ok(None);
+    }
+    windows_cache_path(directory.as_bytes()).map(|value| Some(value.to_owned()))
+}
+
+#[cfg(target_os = "linux")]
+fn windows_cache_path(output: &[u8]) -> Result<&str> {
+    let directory = std::str::from_utf8(output)
+        .map_err(|_| "Windows returned a non-Unicode Git worker cache path.")?;
+    // A WSL UNC cache would recreate the foreign-filesystem startup cost.
+    if !windows_drive_path(directory) || directory.contains(['\r', '\n', '\0']) {
+        return Err("Windows did not return a local Git worker cache path.".into());
+    }
+    Ok(directory)
+}
