+// Diagnostic-only fixed tags; stderr failures must not change request results.
+fn open_phase<T>(tag: &'static str, call: impl FnOnce() -> T) -> T {
+    use std::io::Write;
+    let started = std::time::Instant::now();
+    let result = call();
+    let elapsed_us = started.elapsed().as_micros();
+    let _ = writeln!(
+        std::io::stderr().lock(),
+        "gui_open_phase pid={} tag={} elapsed_us={}",
+        std::process::id(),
+        tag,
+        elapsed_us
+    );
+    result
+}
