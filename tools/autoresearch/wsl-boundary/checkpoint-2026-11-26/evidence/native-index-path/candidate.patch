+#[test]
+fn index_path_resolution_uses_the_private_git_directory_and_preserves_git_fallback() {
+    let dir = history();
+    write(&dir, "tracked", b"base\n");
+    record(&dir, "Base");
+    let linked = tempdir().unwrap();
+    git(
+        dir.path(),
+        &[
+            "worktree",
+            "add",
+            "--detach",
+            linked.path().to_str().unwrap(),
+            "HEAD",
+        ],
+    )
+    .unwrap();
+    let main_repo = open_repo(dir.path()).unwrap();
+    let main_native = main_repo.native().unwrap();
+    let linked_repo = open_repo(linked.path()).unwrap();
+    let linked_native = linked_repo.native().unwrap();
+    let private_index = linked_native.path().join("index");
+    assert_ne!(private_index, main_native.path().join("index"));
+    assert_ne!(private_index, linked_native.commondir().join("index"));
+    assert_eq!(
+        working_tree_index_path(linked.path(), Some(&linked_native), false).unwrap(),
+        private_index
+    );
+    // Force the environment-override branch without changing global process
+    // state. The fallback must use Git's root, rather than the supplied handle.
+    for native in [Some(&main_native), None] {
+        assert_eq!(
+            working_tree_index_path(linked.path(), native, true)
+                .unwrap()
+                .canonicalize()
+                .unwrap(),
+            private_index.canonicalize().unwrap()
+        );
+    }
+    assert_eq!(
+        working_tree_index_path(linked.path(), None, false)
+            .unwrap()
+            .canonicalize()
+            .unwrap(),
+        private_index.canonicalize().unwrap()
+    );
+    // Resolving the filename must not open or parse the index itself.
+    fs::write(&private_index, b"not an index").unwrap();
+    assert_eq!(
+        working_tree_index_path(linked.path(), Some(&linked_native), false).unwrap(),
+        private_index
+    );
+}
