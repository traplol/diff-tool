+fn working_tree_index_path(
+    root: &Path,
+    native: Option<&native::Access<'_>>,
+    environment_overrides: bool,
+) -> Result<PathBuf> {
+    if !environment_overrides {
+        if let Some(repo) = native {
+            return Ok(repo.path().join("index"));
+        }
+    }
+    let index_data = git(root, &["rev-parse", "--git-path", "index"])?;
+    let index = PathBuf::from(path_arg(&name(
+        index_data.strip_suffix(b"\n").unwrap_or(&index_data),
+    ))?);
+    #[cfg(windows)]
+    let index = match windows::WslCheckout::from_path(root) {
+        Some(wsl) if index_data.starts_with(b"/") => wsl.host_path(&index)?,
+        _ => index,
+    };
+    Ok(root.join(index))
+}
