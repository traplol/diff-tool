+#[cfg(unix)]
+#[test]
+fn parallel_untracked_preserves_first_error_with_multiple_failed_reads() {
+    use std::os::unix::fs::PermissionsExt;
+    let dir = history();
+    let root = dir.path();
+    write(&dir, "tracked", b"base\n");
+    record(&dir, "Base");
+    for path in ["a-denied", "b-denied", "c-valid", "d-valid", "e-valid"] {
+        write(&dir, path, b"untracked\n");
+    }
+    let mut repo = open_repo(root).unwrap();
+    repo.native = None;
+    for path in ["a-denied", "b-denied"] {
+        fs::set_permissions(root.join(path), fs::Permissions::from_mode(0)).unwrap();
+    }
+    let before = status_guard_files(root);
+    let expected = local_changes(
+        &repo,
+        "Untracked",
+        &[
+            "--no-index".as_ref(),
+            "--".as_ref(),
+            "/dev/null".as_ref(),
+            "./a-denied".as_ref(),
+        ],
+        true,
+    )
+    .unwrap_err();
+    let actual = working_changes_cli(&repo, &repo.refs[&repo.checkout], None, None).unwrap_err();
+    for path in ["a-denied", "b-denied"] {
+        fs::set_permissions(root.join(path), fs::Permissions::from_mode(0o600)).unwrap();
+    }
+    assert!(expected.contains("a-denied"), "{expected}");
+    assert_eq!(actual, expected);
+    assert_eq!(status_guard_files(root), before);
+    assert_eq!(
+        work(&repo).files.len(),
+        5,
+        "subsequent reads still complete after the error"
+    );
+}
