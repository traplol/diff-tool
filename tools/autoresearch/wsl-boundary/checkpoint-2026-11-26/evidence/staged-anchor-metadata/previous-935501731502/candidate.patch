+#[test]
+fn staged_metadata_reads_index_not_worktree_and_rejects_restage_or_stale_head() {
+    let t = history();
+    write(&t, "code", b"base\n");
+    record(&t, "Base");
+    write(&t, "code", b"staged\n");
+    git(t.path(), &["add", "code"]).unwrap();
+    let repo = open_repo(t.path()).unwrap();
+    let snapshot = work(&repo);
+    let expected = staged_version(file(&snapshot, "Staged", "code"));
+    let index = fs::read(t.path().join(".git/index")).unwrap();
+    write(&t, "code", b"unstaged\n");
+    for args in [
+        &["config", "core.autocrlf", "true"][..],
+        &["config", "filter.explode.clean", "false"],
+        &["config", "core.attributesFile", "missing-attributes"],
+        &["config", "diff.algorithm", "minimal"],
+    ] {
+        git(t.path(), args).unwrap();
+    }
+    write(
+        &t,
+        ".gitattributes",
+        b"code filter=explode working-tree-encoding=UTF-16\n",
+    );
+    fs::remove_file(t.path().join("code")).unwrap();
+    let proof = verify_staged_versions(&repo, &repo.checkout, &[expected.clone()]).unwrap();
+    assert_eq!(proof.versions, [expected.clone()]);
+    assert!(proof.location_head.starts_with("staged:"));
+    assert_eq!(fs::read(t.path().join(".git/index")).unwrap(), index);
+    fs::remove_file(t.path().join(".gitattributes")).unwrap();
+    write(&t, "code", b"restaged\n");
+    git(t.path(), &["add", "code"]).unwrap();
+    assert!(verify_staged_versions(&repo, &repo.checkout, &[expected.clone()]).is_none());
+    git(t.path(), &["commit", "-qm", "Advance HEAD"]).unwrap();
+    assert!(verify_staged_versions(&repo, &repo.checkout, &[expected]).is_none());
+}
