+/// A declined proof leaves callers on the existing frozen-snapshot lookup.
+pub(crate) fn verify_staged_versions(
+    repo: &Repository,
+    checkout: &str,
+    expected: &[StagedVersion],
+) -> Option<StagedProof> {
+    if expected.is_empty() || checkout != repo.checkout {
+        return None;
+    }
+    #[cfg(test)]
+    STAGED_READS.with(|count| count.set(count.get() + 1));
+    #[cfg(not(feature = "storage-worker"))]
+    if let Some(connection) = &repo.remote {
+        return worker_reply(
+            connection,
+            worker::Request::VerifyStagedVersions {
+                view: repo.clone(),
+                checkout: checkout.into(),
+                expected: expected.to_vec(),
+            },
+        )
+        .ok()
+        .flatten();
+    }
+    let head = repo.refs.get(if checkout.starts_with("HEAD@") {
+        "HEAD"
+    } else {
+        checkout
+    })?;
+    let native = repo.native()?;
+    native::verify_staged_versions(&native, checkout, head, expected)
+        .ok()
+        .flatten()
+}
