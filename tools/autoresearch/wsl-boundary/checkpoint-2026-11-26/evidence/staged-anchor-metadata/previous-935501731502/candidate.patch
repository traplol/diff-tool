+#[test]
+fn staged_metadata_requires_exact_raw_path_and_regular_modes() {
+    let t = history();
+    fs::create_dir(t.path().join("Directory")).unwrap();
+    write(&t, "Directory/File", b"base\n");
+    record(&t, "Base");
+    write(&t, "Directory/File", b"staged\n");
+    git(t.path(), &["add", "Directory/File"]).unwrap();
+    git(t.path(), &["config", "core.ignorecase", "true"]).unwrap();
+    let repo = open_repo(t.path()).unwrap();
+    let expected = staged_version(file(&work(&repo), "Staged", "Directory/File"));
+    assert!(verify_staged_versions(&repo, &repo.checkout, &[expected.clone()]).is_some());
+    for path in [
+        "directory/File",
+        "Directory/file",
+        "./Directory/File",
+        "Directory/../File",
+        "Directory//File",
+        "Directory/File\0",
