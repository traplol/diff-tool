+    assert!(verify_staged_versions(&repo, &repo.checkout, &[invalid_mode]).is_none());
+    // Case-only staged rename leaves the saved raw path absent from the index.
+    git(t.path(), &["mv", "Directory/File", "Directory/file"]).unwrap();
