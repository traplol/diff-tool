+#[test]
+fn staged_metadata_preserves_ancestry_fallback_and_commit_tracking() {
+    let t = Checkout::new();
+    t.write("settings", "top\nlimit = 2\nbottom\n");
+    t.git(&["add", "settings"]);
+    let repo = t.repo();
+    let full = t.diff(&repo);
+    let mut note = changed_note(&repo, &full, &full.files[0]);
+    note["id"] = json!(1);
+    let unrelated = git::git(
+        &t.root,
+        &["commit-tree", "HEAD^{tree}", "-m", "Unrelated root"],
+    )
+    .unwrap();
+    let mut unrelated_note = note.clone();
+    unrelated_note["left_tip"] = json!(String::from_utf8(unrelated).unwrap().trim());
+    git::take_working_tree_read_counts();
+    git::take_staged_read_count();
+    let locations = tracking::locate_notes(&repo, &repo.initial, None, &[unrelated_note]);
+    assert_eq!(git::take_staged_read_count(), 1);
+    assert_eq!(git::take_working_tree_read_counts(), (1, 1));
+    assert_eq!(locations[&1].len(), 1);
+    t.commit("Commit reviewed staged change");
+    let current = t.repo();
+    let locations = tracking::locate_notes(&current, &current.initial, None, &[note]);
+    assert_eq!(locations[&1].len(), 1);
+    assert_eq!(locations[&1][0]["right"], current.checkout);
+    assert_eq!(locations[&1][0]["new"], json!([2, 2]));
+}
