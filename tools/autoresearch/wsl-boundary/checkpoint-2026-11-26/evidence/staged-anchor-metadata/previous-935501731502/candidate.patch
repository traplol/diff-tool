+#[test]
+fn staged_metadata_declines_unsupported_raw_tree_mode() {
+    let t = history();
+    write(&t, "code", b"base\n");
+    record(&t, "Base");
+    write(&t, "code", b"staged\n");
+    git(t.path(), &["add", "code"]).unwrap();
+    let view = open_repo(t.path()).unwrap();
+    let expected = staged_version(file(&work(&view), "Staged", "code"));
+    let repo = native::open(t.path()).unwrap();
+    let mut raw = b"100664 code\0".to_vec();
+    raw.extend(git2::Oid::from_str(&expected.old_oid).unwrap().as_bytes());
+    let oid = repo.odb().unwrap().write(git2::ObjectType::Tree, &raw).unwrap();
+    let tree = repo.find_tree(oid).unwrap();
+    assert_eq!(tree.get_name("code").unwrap().filemode(), 0o100644);
+    assert_eq!(tree.get_name("code").unwrap().filemode_raw(), 0o100664);
+    let parent = repo.head().unwrap().peel_to_commit().unwrap();
+    let signature = repo.signature().unwrap();
+    repo.commit(Some("HEAD"), &signature, &signature, "Unsupported raw mode", &tree, &[&parent]).unwrap();
+    let current = open_repo(t.path()).unwrap();
+    assert!(verify_staged_versions(&current, &current.checkout, &[expected]).is_none());
