+#[test]
+fn staged_anchors_share_metadata_proof_and_displayed_snapshot_takes_precedence() {
+    let t = Checkout::new();
+    t.write("settings", "top\nlimit = 2\nbottom\n");
+    t.git(&["add", "settings"]);
+    let repo = t.repo();
+    let full = t.diff(&repo);
+    let notes = (0..100)
+        .map(|id| {
+            let mut note = changed_note(&repo, &full, &full.files[0]);
+            note["id"] = json!(id);
+            note
+        })
+        .collect::<Vec<_>>();
+    // Partial staging and an external edit must not change the staged proof.
+    t.write("settings", "external edit\n");
+    git::take_working_tree_read_counts();
+    git::take_staged_read_count();
+    let located = tracking::locate_notes(&repo, &repo.initial, None, &notes);
+    assert_eq!(git::take_staged_read_count(), 1);
+    assert_eq!(git::take_working_tree_read_counts(), (0, 0));
+    assert_eq!(located.len(), 100);
+    for note in &notes {
+        let location = &located[&note["id"].as_i64().unwrap()][0];
+        assert_eq!(location["new"], note["new"]);
+        assert_eq!(location["blob"], note["file_version"][1]);
+        assert!(s(location, "head").starts_with("staged:"));
+    }
+    // Restaging invalidates the metadata proof, but never the displayed snapshot.
+    t.git(&["add", "settings"]);
+    let displayed = tracking::locate_notes(&repo, &repo.initial, Some(&full), &notes);
+    assert_eq!(git::take_staged_read_count(), 0);
+    assert_eq!(git::take_working_tree_read_counts(), (0, 0));
+    assert!(displayed
+        .values()
+        .all(|locations| locations[0]["head"] == full.head));
+    let current = t.diff(&repo);
+    let expected = tracking::locate_notes(&repo, &repo.initial, Some(&current), &notes);
+    git::take_working_tree_read_counts();
+    let actual = tracking::locate_notes(&repo, &repo.initial, None, &notes);
+    assert_eq!(git::take_staged_read_count(), 1);
+    assert_eq!(git::take_working_tree_read_counts(), (1, 1));
+    assert_eq!(actual, expected);
+}
