+fn staged_version(file: &Change) -> StagedVersion {
+    StagedVersion {
+        path: file.path.clone(),
+        old_oid: file.old_oid.clone(),
+        oid: file.oid.clone(),
+        old_mode: file.old_mode.clone(),
+        mode: file.mode.clone(),
+    }
+}
