+#[test]
+fn staged_metadata_rejects_intent_to_add_conflicts_and_non_modifications() {
+    let t = history();
+    write(&t, "code", b"base\n");
+    record(&t, "Base");
+    let repo = open_repo(t.path()).unwrap();
+    let base = git_text(t.path(), &["rev-parse", "HEAD:code"]).unwrap();
+    let empty = git_text(t.path(), &["hash-object", "--stdin"]).unwrap();
+    git(t.path(), &["rm", "--cached", "code"]).unwrap();
+    git(t.path(), &["add", "-N", "code"]).unwrap();
+    let expected = StagedVersion {
+        path: "code".into(),
+        old_oid: base.clone(),
+        oid: empty,
+        old_mode: "100644".into(),
+        mode: "100644".into(),
+    };
+    assert!(verify_staged_versions(&repo, &repo.checkout, &[expected.clone()]).is_none());
+    git(t.path(), &["add", "code"]).unwrap();
+    let unchanged = StagedVersion {
+        oid: base,
+        ..expected.clone()
+    };
+    assert!(verify_staged_versions(&repo, &repo.checkout, &[unchanged]).is_none());
+    write(&t, "code", b"changed\n");
+    git(t.path(), &["add", "code"]).unwrap();
+    let expected = staged_version(file(&work(&repo), "Staged", "code"));
+    let mut index = native::open(t.path()).unwrap().index().unwrap();
+    let mut entry = index.get_path(Path::new("code"), 0).unwrap();
+    index.remove_path(Path::new("code")).unwrap();
+    entry.flags = (entry.flags & !0x3000) | 0x1000;
+    index.add(&entry).unwrap();
+    entry.flags = (entry.flags & !0x3000) | 0x2000;
+    index.add(&entry).unwrap();
+    index.write().unwrap();
+    assert!(verify_staged_versions(&repo, &repo.checkout, &[expected]).is_none());
+}
