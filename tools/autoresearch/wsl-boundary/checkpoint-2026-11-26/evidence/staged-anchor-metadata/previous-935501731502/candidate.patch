+// Read staged facts only. Worktree conversions and sparse omissions elsewhere
+// cannot change objects that are already in the index.
+pub(super) fn verify_staged_versions(
+    repo: &Repository,
+    checkout_name: &str,
+    head: &str,
+    expected: &[super::StagedVersion],
+) -> Result<Option<super::StagedProof>> {
+    let config = repo.config()?;
+    if config
+        .get_str("extensions.objectFormat")
+        .is_ok_and(|value| value != "sha1")
+        || config.get_entry("extensions.compatObjectFormat").is_ok()
+        || config.get_entry("extensions.refStorage").is_ok()
+    {
+        return Ok(None);
+    }
+    let wanted_checkout = (checkout_name.to_string(), Some(head.to_string()));
+    if checkout(repo)? != wanted_checkout {
+        return Ok(None);
+    }
+    let mut index = repo.index()?;
+    let Some(index_path) = index.path().map(Path::to_path_buf) else {
+        return Ok(None);
+    };
+    let initial_index = super::index_state(&index_path).map_err(|e| git2::Error::from_str(&e))?;
+    index.read(true)?;
+    if index.has_conflicts() {
+        return Ok(None);
+    }
+    let tree = repo.find_commit(Oid::from_str(head)?)?.tree()?;
+    let mut versions = Vec::new();
+    for version in expected {
+        if !matches!(version.old_mode.as_str(), "100644" | "100755")
+            || !matches!(version.mode.as_str(), "100644" | "100755")
+        {
+            continue;
+        }
+        let path = path_arg(&version.path).map_err(|e| git2::Error::from_str(&e))?;
+        let raw = path.as_encoded_bytes();
+        if !Path::new(&path)
+            .components()
+            .all(|part| matches!(part, std::path::Component::Normal(_)))
+            || raw.contains(&0)
+            || raw
+                .split(|b| *b == b'/')
+                .any(|part| matches!(part, b"" | b"." | b".."))
+        {
+            continue;
+        }
+        let Some(entry) = index.get_path(Path::new(&path), 0) else {
+            continue;
+        };
+        let flags = git2::IndexEntryExtendedFlag::from_bits_truncate(entry.flags_extended);
+        // get_path can obey an ignore-case index comparator. Require raw bytes.
+        if entry.path != raw || flags.is_skip_worktree() || flags.is_intent_to_add() {
+            continue;
+        }
+        let Some(old) = exact_tree_entry(repo, &tree, raw) else {
+            continue;
+        };
+        let old_mode = format!("{:06o}", old.filemode_raw());
+        let mode = format!("{:06o}", entry.mode);
+        if old_mode == version.old_mode
+            && mode == version.mode
+            && old.id().to_string() == version.old_oid
+            && entry.id.to_string() == version.oid
+            && (old.id() != entry.id || old_mode != mode)
+        {
+            versions.push(version.clone());
+        }
+    }
+    if checkout(repo)? != wanted_checkout
+        || super::index_state(&index_path).map_err(|e| git2::Error::from_str(&e))? != initial_index
+    {
+        return Ok(None);
+    }
+    if versions.is_empty() {
+        return Ok(None);
+    }
+    versions.sort();
+    versions.dedup();
+    use sha2::{Digest, Sha256};
+    let mut digest = Sha256::new();
+    digest.update(head.as_bytes());
+    for version in &versions {
+        for value in [
+            &version.path,
+            &version.old_oid,
+            &version.oid,
+            &version.old_mode,
+            &version.mode,
+        ] {
+            digest.update([0]);
+            digest.update(value.as_bytes());
+        }
+    }
+    Ok(Some(super::StagedProof {
+        base: head.to_string(),
+        location_head: format!("staged:{:x}", digest.finalize()),
+        versions,
+    }))
+}
+
+fn exact_tree_entry(
+    repo: &Repository,
+    tree: &Tree<'_>,
+    path: &[u8],
+) -> Option<git2::TreeEntry<'static>> {
+    let mut tree = tree.clone();
+    let mut parts = path.split(|b| *b == b'/').peekable();
+    loop {
+        let part = parts.next()?;
+        let entry = tree.get_name_bytes(part)?.to_owned();
+        if entry.name_bytes() != part {
+            return None;
+        }
+        if parts.peek().is_none() {
+            return Some(entry);
+        }
+        tree = repo.find_tree(entry.id()).ok()?;
+    }
+}
