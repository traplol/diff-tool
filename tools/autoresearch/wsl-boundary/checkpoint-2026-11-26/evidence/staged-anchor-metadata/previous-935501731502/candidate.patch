+    git(t.path(), &["mv", "Directory", "temporary-directory"]).unwrap();
+    git(t.path(), &["mv", "temporary-directory", "directory"]).unwrap();
+    let renamed = StagedVersion {
+        path: "directory/file".into(),
+        ..expected
+    };
+    assert!(verify_staged_versions(&repo, &repo.checkout, &[renamed]).is_none());
+}
